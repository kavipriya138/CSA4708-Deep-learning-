import numpy as np
import matplotlib.pyplot as plt

def gradient(w):
    return 2 * (w - 5)

epochs = 50
lr = 0.1

# Gradient Descent
w1 = 0
gd = []

for i in range(epochs):
    w1 -= lr * gradient(w1)
    gd.append(w1)

# SGD
w2 = 0
sgd = []

for i in range(epochs):
    w2 -= lr * gradient(w2) + np.random.normal(0, 0.1)
    sgd.append(w2)

# Momentum
w3 = 0
v = 0
momentum = []

for i in range(epochs):
    v = 0.9 * v + gradient(w3)
    w3 -= lr * v
    momentum.append(w3)

# Adam
w4 = 0
m = 0
v = 0
adam = []

for t in range(1, epochs + 1):
    g = gradient(w4)
    m = 0.9*m + 0.1*g
    v = 0.999*v + 0.001*g*g

    m_hat = m/(1-0.9**t)
    v_hat = v/(1-0.999**t)

    w4 -= lr*m_hat/(np.sqrt(v_hat)+1e-8)
    adam.append(w4)

plt.plot(gd, label="Gradient Descent")
plt.plot(sgd, label="SGD")
plt.plot(momentum, label="Momentum")
plt.plot(adam, label="Adam")

plt.axhline(5, color="black", linestyle="--")
plt.title("Optimizer Comparison")
plt.xlabel("Epochs")
plt.ylabel("Weight")
plt.legend()
plt.grid()
plt.show()
