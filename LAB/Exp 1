import numpy as np
import matplotlib.pyplot as plt

# Create vectors
A = np.array([1, 2, 3])
B = np.array([4, 5, 6])

print("Vector A:", A)
print("Vector B:", B)

print("Addition:", A + B)
print("Subtraction:", A - B)
print("Dot Product:", np.dot(A, B))

# Create matrices
M1 = np.array([[1, 2], [3, 4]])
M2 = np.array([[5, 6], [7, 8]])

print("Matrix Addition:\n", M1 + M2)
print("Matrix Multiplication:\n", np.dot(M1, M2))
print("Transpose:\n", M1.T)
print("Determinant:", np.linalg.det(M1))
print("Inverse:\n", np.linalg.inv(M1))

# Visualization
plt.plot(A, label="Vector A")
plt.plot(B, label="Vector B")
plt.title("Vector Visualization")
plt.xlabel("Index")
plt.ylabel("Values")
plt.legend()
plt.grid()
plt.show()
